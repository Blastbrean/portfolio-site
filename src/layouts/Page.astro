---
import { ClientRouter } from "astro:transitions";
import { PRIVATE_BIRTH_DATE } from "astro:env/server";
import { calculateAge } from "../lib/age";
import Background from "../components/Background.astro";
import { site } from "../site";
import "../styles/theme.css";
import "../styles/experience.css";
interface Props {
  frontmatter: { title: string; tabTitle?: string; description?: string; ageFallback?: number };
}
const { frontmatter } = Astro.props;
const content = await Astro.slots.render('default');
const age = PRIVATE_BIRTH_DATE ? calculateAge(PRIVATE_BIRTH_DATE) : frontmatter.ageFallback;
const renderedContent = age === undefined ? content : content.replaceAll('{{age}}', `<span data-profile-age>${age}</span>`);
const links = [
  { href: "/", label: "Home" },
  { href: "/work/", label: "Work" },
  { href: "/projects/", label: "Projects" },
  { href: "/contact/", label: "Contact" },
];
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = new URL(Astro.url.pathname, Astro.site);
const description = frontmatter.description ?? site.description;
const previewTitle = current === '/' ? site.previewTitle : `${frontmatter.title} · ${site.name}`;
const previewImage = new URL(site.previewImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <ClientRouter />
    <script>
      import '../scripts/timeline';
      // Chromium can include the moving backdrop in transparent view-transition
      // snapshots. Animate the live content instead, keeping the backdrop separate.
      document.addEventListener("astro:before-swap", (event) => {
        // Skipping rejects `ready` by design; handle that expected rejection.
        void event.viewTransition.ready.catch(() => {});
        event.viewTransition.skipTransition();
      });
      document.addEventListener("astro:after-swap", () => {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        document.getElementById("content")?.animate(
          [{ opacity: 0 }, { opacity: 1 }],
          { duration: 160, easing: "ease-out" },
        );
      });
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      {frontmatter.tabTitle ?? `${frontmatter.title} · ${site.name}`}
    </title>
    <link rel="icon" href={site.favicon} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={previewTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={previewImage.href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.previewImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={previewTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage.href} />
    <meta name="twitter:image:alt" content={site.previewImageAlt} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        const key = "blastbrean-theme";
        const system = window.matchMedia("(prefers-color-scheme: dark)");
        let preference = null;
        const valid = (value) => ["light", "dark"].includes(value);
        try {
          const saved = localStorage.getItem(key);
          if (valid(saved)) preference = saved;
        } catch {
          /* Keep system mode when browser storage is unavailable. */
        }

        const apply = () => {
          const theme = preference ?? (system.matches ? "dark" : "light");
          document.documentElement.dataset.theme = theme;
          const control = document.getElementById("theme");
          if (control) control.value = preference ?? "system";
        };
        // Apply before the page paints to avoid flashing the wrong theme.
        apply();
        system.addEventListener("change", apply);
        window.addEventListener("storage", (event) => {
          if (event.key !== key && event.key !== null) return;
          preference = valid(event.newValue) ? event.newValue : null;
          apply();
        });
        const bindControl = () => {
          const control = document.getElementById("theme");
          if (!control) return;
          if (control.dataset.bound) { apply(); return; }
          control.dataset.bound = "true";
          apply();
          control.addEventListener("change", () => {
            preference = valid(control.value) ? control.value : null;
            apply();
            try {
              if (preference === null) localStorage.removeItem(key);
              else localStorage.setItem(key, preference);
            } catch {
              /* The choice still works for the current page. */
            }
          });
          control.closest(".theme-control").hidden = false;
        };
        document.addEventListener("DOMContentLoaded", bindControl);
        document.addEventListener("astro:page-load", bindControl);
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>
  </head>
  <body>
    <Background />
    <a class="skip" href="#content">Skip to content</a>
    <header>
      <nav aria-label="Main navigation">
        {
          links.map(({ href, label }) => (
            <a
              href={href}
              aria-current={
                current === (href.replace(/\/$/, "") || "/")
                  ? "page"
                  : undefined
              }
            >
              {label}
            </a>
          ))
        }
      </nav>
      <label class="theme-control" hidden>
        <span>Theme</span>
        <select id="theme" name="theme">
          <option value="system">System</option>
          <option value="light">Light</option>
          <option value="dark">Dark</option>
        </select>
      </label>
      <button id="background-toggle" type="button" hidden>Pause background</button>
    </header>
    <main id="content" tabindex="-1"><Fragment set:html={renderedContent} /></main>
    <footer>
      <section class="background-options" aria-label="Background controls" data-background-options hidden>
        <div class="background-controls-row">
          <label class="shortcut-control"><input id="background-shortcuts" type="checkbox" checked /> Keyboard controls</label>
          <div class="speed-control">
            <label for="background-speed">Speed</label>
            <input id="background-speed" type="range" min="0.1" max="20" step="0.1" value="1" />
            <output id="background-speed-value" for="background-speed" aria-live="off">1.0×</output>
          </div>
        </div>
        <p>WASD move · ← / → rewind / forward · = / - rotate · [ / ] speed · Space pause</p>
      </section>
    </footer>
  </body>
</html>
<style is:global>
  html { view-transition-name: none; }
  * {
    box-sizing: border-box;
  }
  body {
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    max-width: 48rem;
    margin: auto;
    padding: clamp(1rem, 5vh, 4rem) 1.25rem 0;
    overflow-wrap: anywhere;
  }
  a {
    color: var(--link);
    text-underline-offset: 0.2em;
  }
  a:hover {
    text-decoration-thickness: 2px;
  }
  :focus-visible {
    outline: 3px solid var(--link);
    outline-offset: 4px;
  }
  /* Main receives focus for navigation and the skip link, but is not a control. */
  main:focus { outline: none; }
  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .theme-control {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
  }
  .theme-control[hidden] {
    display: none;
  }
  footer { padding: 1.5rem 0 2rem; border-top: 1px solid var(--border); }
  .background-options { font-size: 0.9rem; }
  .background-controls-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 2rem; justify-content: space-between; }
  .shortcut-control { display: flex; align-items: center; gap: 0.5rem; min-height: 2rem; }
  .background-options p { margin: 0.75rem 0 0; color: var(--muted); font-size: 0.8rem; }
  .background-options input[type="checkbox"] { width: 1.1rem; height: 1.1rem; margin: 0; accent-color: var(--link); }
  .speed-control { display: flex; align-items: center; gap: 0.75rem; flex: 1 1 18rem; max-width: 26rem; min-width: 0; }
  #background-speed-value { min-width: 3.3rem; font-variant-numeric: tabular-nums; text-align: right; }
  #background-speed { flex: 1; min-width: 0; width: 100%; min-height: 2rem; margin: 0; accent-color: var(--link); }
  .theme-control select {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    font-size: 1rem;
    line-height: 1.2;
    min-height: 2.5rem;
    color: var(--text);
    background-color: var(--surface);
    background-image: linear-gradient(45deg, transparent 50%, var(--text) 50%),
      linear-gradient(135deg, var(--text) 50%, transparent 50%);
    background-position: calc(100% - 0.95rem) 50%, calc(100% - 0.65rem) 50%;
    background-size: 0.3rem 0.3rem;
    background-repeat: no-repeat;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    padding: 0.5rem 2rem 0.5rem 0.75rem;
    cursor: pointer;
  }
  ::selection {
    color: var(--text);
    background: var(--accent);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
  }
  nav a {
    color: inherit;
    padding: 0.4rem 0.7rem;
    text-decoration: underline;
  }
  nav a:hover {
    background: var(--hover-surface);
    text-decoration: underline;
  }
  nav a[aria-current="page"] {
    color: var(--heading);
    font-weight: 700;
  }
  main {
    position: relative;
    flex: 1;
    min-width: 0;
    padding: 2rem 0 4rem;
  }
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-heading);
    font-weight: 700;
  }
  h1 {
    color: var(--heading);
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.15;
    margin: 0 0 1.5rem;
  }
  h2 {
    color: var(--heading);
    line-height: 1.3;
    margin-top: 2.5rem;
  }
  p,
  ul,
  ol,
  blockquote {
    max-width: 68ch;
  }
  img,
  video {
    display: block;
    max-width: 100%;
    height: auto;
  }
  figure {
    margin: 2rem 0;
  }
  figure img {
    width: 100%;
  }
  figcaption {
    max-width: 68ch;
    margin-top: 0.65rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  pre {
    overflow-x: auto;
    padding: 1rem;
  }
  #background-toggle {
    font: inherit;
    font-size: 1rem;
    line-height: 1.2;
    min-height: 2.5rem;
    border-radius: 0.25rem;
    color: var(--link);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    cursor: pointer;
  }
  #background-toggle[hidden] { display: none; }
  .empty {
    color: var(--muted);
  }
  .skip {
    position: absolute;
    left: 1rem;
    top: -5rem;
    background: var(--background);
    padding: 0.5rem;
  }
  .skip:focus {
    top: 0.5rem;
  }
  @media (max-width: 40rem) {
    header {
      align-items: flex-start;
      flex-direction: column;
    }
    main {
      padding-top: 1.5rem;
    }
  }
  @media (min-width: 160rem) {
    :root {
      font-size: clamp(1.125rem, 0.8vw, 1.5rem);
    }
  }
</style>
