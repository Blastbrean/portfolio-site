---
import { site } from "../site";
import catalog from "../data/music-catalog.json";
---

<div
  class="personal-background"
  aria-hidden="true"
  data-paused="true"
  data-catalog={JSON.stringify(catalog)}
  data-photos={JSON.stringify(site.backgroundImages)}
  transition:persist="personal-background"
>
  <div class="background-tilt">
    <div class="background-grid"></div>
  </div>
</div>

<script>
  const background = document.querySelector<HTMLElement>(
    ".personal-background",
  );
  if (background) {
    const grid = background.querySelector<HTMLElement>(".background-grid")!;
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    let paused = reducedMotion.matches;
    let frame: number | undefined;
    let lastTime: number | undefined;
    let distance = 0;
    let phase = 0;
    let verticalPeriod = 0;
    let panX = 0;
    let panY = 0;
    let rotation = 45;
    let speed = 1;
    let shortcuts = true;
    try { shortcuts = localStorage.getItem('blastbrean-shortcuts') !== 'off'; } catch {}
    let navigating = false;
    const held = new Set<string>();
    const controls = new Set(['KeyW', 'KeyA', 'KeyS', 'KeyD', 'ArrowLeft', 'ArrowRight', 'Equal', 'Minus', 'BracketLeft', 'BracketRight']);
    const interactive = 'dialog[open], input, textarea, select, button, a, video, audio, summary, [contenteditable]:not([contenteditable="false"]), [role="button"], [role="textbox"], [role="combobox"]';
    const wrap = (value: number, period: number) => ((value % period) + period) % period;
    const paint = () => {
      if (!distance || !verticalPeriod) return;
      const x = wrap(phase + panX, distance) - distance / 2;
      const y = wrap(panY + verticalPeriod / 2, verticalPeriod) - verticalPeriod / 2;
      grid.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      background.style.setProperty('--rotation', `${rotation}deg`);
    };
    const draw = (time: number) => {
      frame = undefined;
      if ((paused && !held.size) || document.hidden || navigating || !distance) {
        lastTime = undefined;
        return;
      }
      if (lastTime !== undefined) {
        // Resume from the same position after a stall or a hidden tab.
        const delta = Math.min(Math.max(time - lastTime, 0), 64) / 1000;
        const horizontal = Number(held.has('KeyD')) - Number(held.has('KeyA'));
        const vertical = Number(held.has('KeyS')) - Number(held.has('KeyW'));
        const length = Math.hypot(horizontal, vertical) || 1;
        speed = Math.min(20, Math.max(0.1, speed + (Number(held.has('BracketRight')) - Number(held.has('BracketLeft'))) * delta));
        const x = horizontal / length * 180 * delta * speed;
        const y = vertical / length * 180 * delta * speed;
        const angle = rotation * Math.PI / 180;
        panX = wrap(panX + x * Math.cos(angle) + y * Math.sin(angle), distance);
        panY = wrap(panY - x * Math.sin(angle) + y * Math.cos(angle), verticalPeriod);
        const direction = Number(held.has('ArrowRight')) - Number(held.has('ArrowLeft'));
        phase = wrap(phase + ((paused ? 0 : 22) + direction * 180) * delta * speed, distance);
        rotation = wrap(rotation + (Number(held.has('Equal')) - Number(held.has('Minus'))) * 24 * delta * speed, 360);
      }
      lastTime = time;
      paint();
      if (held.has('BracketLeft') || held.has('BracketRight')) updateControls();
      frame = requestAnimationFrame(draw);
    };
    const updateControls = () => {
      background.dataset.speed = speed.toFixed(2);
      const options = document.querySelector<HTMLElement>('[data-background-options]');
      if (options) options.hidden = false;
      const setting = document.querySelector<HTMLInputElement>('#background-shortcuts');
      if (setting) setting.checked = shortcuts;
      const slider = document.querySelector<HTMLInputElement>('#background-speed');
      if (slider) {
        slider.value = String(speed);
        slider.setAttribute('aria-valuetext', `${speed.toFixed(1)} times normal speed`);
      }
      const output = document.querySelector('#background-speed-value');
      if (output && output.textContent !== `${speed.toFixed(1)}×`) output.textContent = `${speed.toFixed(1)}×`;
    };
    const sync = () => {
      const toggle =
        document.querySelector<HTMLButtonElement>("#background-toggle");
      if (toggle) {
        toggle.hidden = false;
        toggle.textContent = paused ? "Resume background" : "Pause background";
        toggle.setAttribute("aria-pressed", String(paused));
        toggle.setAttribute("aria-keyshortcuts", "Space");
        toggle.title = shortcuts ? "Space pauses or resumes the background" : "Pause or resume the background";
      }
      const stopped = paused || document.hidden || navigating;
      background.dataset.paused = String(stopped);
      document.documentElement.dataset.motionPaused = String(paused || reducedMotion.matches);
      updateControls();
      if (document.hidden || navigating || (paused && !held.size)) {
        if (frame !== undefined) cancelAnimationFrame(frame);
        frame = undefined;
        lastTime = undefined;
      } else if (distance && frame === undefined) {
        frame = requestAnimationFrame(draw);
      }
    };
    document.addEventListener("click", (event) => {
      if ((event.target as Element)?.closest("#background-toggle")) {
        paused = !paused;
        sync();
      }
    });
    document.addEventListener('change', (event) => {
      const target = event.target as HTMLInputElement;
      if (target.id !== 'background-shortcuts') return;
      shortcuts = target.checked;
      held.clear();
      try { localStorage.setItem('blastbrean-shortcuts', shortcuts ? 'on' : 'off'); } catch {}
      sync();
    });
    document.addEventListener('input', (event) => {
      const target = event.target as HTMLInputElement;
      if (target.id !== 'background-speed') return;
      speed = Math.min(20, Math.max(0.1, Number(target.value)));
      updateControls();
    });
    document.addEventListener("keydown", (event) => {
      if (
        !shortcuts || event.isComposing || event.defaultPrevented ||
        event.ctrlKey ||
        event.metaKey ||
        event.altKey
      )
        return;
      const target = event.target as HTMLElement;
      if (target.closest(interactive)) return;
      if (event.code === 'Space') {
        if (event.repeat || event.shiftKey) return;
        event.preventDefault();
        paused = !paused;
        sync();
        return;
      }
      if (!distance || !controls.has(event.code)) return;
      event.preventDefault();
      held.add(event.code);
      sync();
    });
    document.addEventListener('keyup', (event) => {
      if (held.delete(event.code)) sync();
    });
    const releaseControls = () => { held.clear(); sync(); };
    window.addEventListener('blur', releaseControls);
    document.addEventListener('focusin', (event) => {
      if ((event.target as Element)?.closest(interactive)) releaseControls();
    });
    reducedMotion.addEventListener("change", () => {
      paused = reducedMotion.matches;
      sync();
    });
    const restart = () => {
      held.clear();
      if (frame !== undefined) cancelAnimationFrame(frame);
      frame = undefined;
      lastTime = undefined;
      navigating = false;
      sync();
    };
    document.addEventListener("visibilitychange", restart);
    window.addEventListener("pageshow", restart);
    document.addEventListener("astro:before-swap", () => {
      navigating = true;
      held.clear();
      sync();
    });
    // Schedule on the new document after Safari moves the persistent element.
    document.addEventListener("astro:after-swap", restart);
    document.addEventListener("astro:page-load", restart);
    sync();

    // Shuffle the complete catalog once per tab. Navigation preserves this texture.
    const catalog: { artist: string; albums: { image: string }[] }[] =
      JSON.parse(background.dataset.catalog ?? "[]");
    const photos: string[] = JSON.parse(background.dataset.photos ?? "[]");
    const selected = [
      ...new Set([
        ...catalog.flatMap(({ albums }) => albums.map((album) => album.image)),
        ...photos,
      ]),
    ];
    for (let i = selected.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [selected[i], selected[j]] = [selected[j], selected[i]];
    }
    const load = (src: string) =>
      new Promise<HTMLImageElement>((resolve, reject) => {
        const image = new Image();
        image.decoding = "async";
        image.onload = () => resolve(image);
        image.onerror = reject;
        image.src = src;
      });
    Promise.allSettled(selected.map(load)).then((results) => {
      const images = results.flatMap((result) =>
        result.status === "fulfilled" ? [result.value] : [],
      );
      if (!images.length) return;
      const columns = Math.ceil(Math.sqrt(images.length));
      const rows = Math.ceil(images.length / columns);
      const cell = 96;
      const canvas = document.createElement("canvas");
      canvas.width = columns * cell;
      canvas.height = rows * cell;
      const context = canvas.getContext("2d");
      if (!context) return;
      // Bake the blur once into a tiny texture; no live SVG or full-screen filter.
      const supportsBlur = "filter" in context;
      if (supportsBlur) context.filter = "blur(3px)";
      for (let index = 0; index < columns * rows; index++) {
        const image = images[index % images.length];
        const side = Math.min(image.naturalWidth, image.naturalHeight);
        context.drawImage(
          image,
          (image.naturalWidth - side) / 2,
          (image.naturalHeight - side) / 2,
          side,
          side,
          (index % columns) * cell + 3,
          Math.floor(index / columns) * cell + 3,
          cell - 6,
          cell - 6,
        );
      }
      if (!supportsBlur) {
        // Safari versions without canvas filters still get a softened texture.
        const soft = document.createElement("canvas");
        soft.width = Math.max(1, Math.floor(canvas.width / 4));
        soft.height = Math.max(1, Math.floor(canvas.height / 4));
        const softContext = soft.getContext("2d");
        if (softContext) {
          softContext.drawImage(canvas, 0, 0, soft.width, soft.height);
          context.clearRect(0, 0, canvas.width, canvas.height);
          context.imageSmoothingEnabled = true;
          context.imageSmoothingQuality = "high";
          context.drawImage(soft, 0, 0, canvas.width, canvas.height);
        }
      }
      background.style.setProperty("--period", `${columns * 220}px`);
      grid.style.backgroundSize = `${columns * 220}px ${rows * 220}px`;
      grid.style.backgroundImage = `url("${canvas.toDataURL("image/webp", 0.75)}")`;
      distance = columns * 220;
      verticalPeriod = rows * 220;
      paint();
      sync();
      background.dataset.loadedCount = String(images.length);
      background.dataset.ready = "true";
      background.dataset.selection = JSON.stringify(selected);
    });
  }
</script>

<style>
  .personal-background {
    view-transition-name: none !important;
    --period: 440px;
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: var(--background);
  }
  .background-tilt {
    position: absolute;
    top: 50%;
    left: 50%;
    width: calc(150vmax + var(--period));
    height: calc(150vmax + var(--period));
    transform: translate(-50%, -50%) rotate(var(--rotation, 45deg));
    opacity: 0;
    transition: opacity 600ms ease;
  }
  .personal-background[data-ready="true"] .background-tilt {
    opacity: 1;
  }
  .background-grid {
    width: 100%;
    height: 100%;
    background-size: 220px 220px;
    background-repeat: repeat;
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .background-tilt {
      transition: none;
    }
  }
  .personal-background::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--background-scrim);
  }
</style>
